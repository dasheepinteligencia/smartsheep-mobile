{
  "expo": {
    "name": "SmartSheep",
    "slug": "APP_COLETA_MOBILE",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appcoletamobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dasheepinteligencia.omnifield",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "O SmartSheep utiliza sua localização para validar visitas, check-ins, check-outs e evidências de campo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/w_android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.dasheepinteligencia.APP_COLETA_MOBILE",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1C1C",
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1C1C1C",
            "image": "./assets/images/android-icon-foreground.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O SmartSheep utiliza sua localização para validar visitas, check-ins, check-outs e evidências de campo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3954c913-e760-4b2a-9a86-8365e8cdaf90"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3954c913-e760-4b2a-9a86-8365e8cdaf90"
    }
  }
}
